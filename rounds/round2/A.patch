diff --git a/tests/test_completed_date.py b/tests/test_completed_date.py
new file mode 100644
index 0000000..4d4ae6c
--- /dev/null
+++ b/tests/test_completed_date.py
@@ -0,0 +1,25 @@
+import unittest
+from datetime import date
+
+from dto.add_task_request import AddTaskRequest
+from dto.task_operation_request import TaskOperationRequest
+from persistence.in_memory_task_repository import InMemoryTaskRepository
+from use_cases.add_task import AddTaskUseCase
+from use_cases.complete_task import CompleteTaskUseCase
+
+
+class CompletedDateTests(unittest.TestCase):
+    def test_new_task_has_no_completed_date(self):
+        repo = InMemoryTaskRepository()
+        task = AddTaskUseCase(repo)(AddTaskRequest("write report")).task
+        self.assertIsNone(task.completed_date)
+
+    def test_completing_a_task_records_today(self):
+        repo = InMemoryTaskRepository()
+        task = AddTaskUseCase(repo)(AddTaskRequest("write report")).task
+        CompleteTaskUseCase(repo)(TaskOperationRequest(task.id))
+        self.assertEqual(date.today(), repo.get_by_id(task.id).completed_date)
+
+
+if __name__ == "__main__":
+    unittest.main()
