@@ -0,0 +1,15 @@
+import unittest
+
+from entity.task import Task
+
+
+class PriorityTests(unittest.TestCase):
+    def test_default_priority_is_normal(self):
+        self.assertEqual("normal", Task(description="read chapter 3", id=1).priority)
+
+    def test_priority_can_be_set(self):
+        self.assertEqual("high", Task(description="read chapter 3", id=1, priority="high").priority)
+
+
+if __name__ == "__main__":
+    unittest.main()
