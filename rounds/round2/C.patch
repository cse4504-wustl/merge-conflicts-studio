+++ b/tests/test_due_date.py
@@ -0,0 +1,17 @@
+import unittest
+from datetime import date
+
+from entity.task import Task
+
+
+class DueDateTests(unittest.TestCase):
+    def test_default_due_date_is_none(self):
+        self.assertIsNone(Task(description="submit lab", id=1).due_date)
+
+    def test_due_date_can_be_set(self):
+        due = date(2026, 12, 1)
+        self.assertEqual(due, Task(description="submit lab", id=1, due_date=due).due_date)
+
+
+if __name__ == "__main__":
+    unittest.main()
