+import unittest
+
+from dto.add_task_request import AddTaskRequest
+from dto.task_operation_request import TaskOperationRequest
+from persistence.in_memory_task_repository import InMemoryTaskRepository
+from use_cases.add_task import AddTaskUseCase
+from use_cases.complete_task import CompleteTaskUseCase
+from use_cases.reopen_task import ReopenTaskUseCase
+
+
+class ReopenTaskTests(unittest.TestCase):
+    def test_reopen_clears_completion(self):
+        repo = InMemoryTaskRepository()
+        task = AddTaskUseCase(repo)(AddTaskRequest("fix bug")).task
+        CompleteTaskUseCase(repo)(TaskOperationRequest(task.id))
+
+        response = ReopenTaskUseCase(repo)(TaskOperationRequest(task.id))
+
+        self.assertTrue(response.success)
+        self.assertFalse(task.completed)
+        self.assertIsNone(task.completed_date)
+
+    def test_reopen_missing_task_fails(self):
+        response = ReopenTaskUseCase(InMemoryTaskRepository())(TaskOperationRequest(42))
+        self.assertFalse(response.success)
+
+
+if __name__ == "__main__":
+    unittest.main()
